<?xml version="1.0" encoding="utf-8"?>
<!-- 注意：RemoteViews（桌面小组件）不支持 ?attr/ 主题属性，颜色必须写具体 @color 资源。
     @color/* 在 values-night 里有深色覆盖，可自动跟随系统日夜。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvWidgetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <ImageView
                android:id="@+id/btnWidgetRefresh"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="2dp"
                android:src="@drawable/ic_refresh_dark"
                android:contentDescription="刷新" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWidgetStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="3dp" />

        <Chronometer
            android:id="@+id/chronoCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_pill_yellow"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:text="--:--"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/pill_yellow_text" />

        <TextView
            android:id="@+id/tvWidgetUpdated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/tvWidgetSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/gold"
            android:layout_marginTop="3dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llWidgetItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvWidgetGoods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="6dp"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
